{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "server": {
      "entry": ["tests/**/*.test.ts", "src/scripts/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "client": {
      "entry": ["tests/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreExportsUsedInFile": true
}
