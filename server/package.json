{
  "name": "cocktail-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "hash-password": "tsx src/scripts/hashPassword.ts",
    "snapshot": "tsx src/scripts/snapshot.ts"
  },
  "dependencies": {
    "@cocktail/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint/js": "^9.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^24.19.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.1.1",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.7.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
