PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=info

# Path where the SQLite database file (cocktail.db) is stored.
# In development this defaults to <cwd>/data-store/ if unset.
# When running via Docker Compose this is set to /data (see docker-compose.yml).
DATA_DIR=./server/data-store

# --- Admin login (required when NODE_ENV=production) ---
# Create the hash with: npm run hash-password --workspace=server
# Keep the single quotes — Docker Compose reads every $ in it otherwise.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH='scrypt$32768$8$1$<salt>$<key>'
# How long a login lasts, in days (1–365).
SESSION_TTL_DAYS=30

# Host port for `docker compose up` (docker-compose.yml); default 3009, chosen
# to stay clear of the other local stacks. CLIENT_ORIGIN for that stack follows it.
# HOST_PORT=3009

# Proxies in front of the app: 0 locally, 1 behind Caddy (compose.prod.yaml sets it).
TRUST_PROXY_HOPS=0

# In production CLIENT_ORIGIN must be the public https:// address, without a path.
# Docker network your Caddy is on (compose.prod.yaml); default: caddy.
CADDY_NETWORK=caddy

# Only for docker-compose-test.yml: this PC's IPv4 address on the home network,
# the same value as LAN_HOST in BinMark's infra/edge/.env. The test stack accepts
# logins and changes from https://<LAN_HOST>:8291 (default: localhost).
# LAN_HOST=192.168.0.10
