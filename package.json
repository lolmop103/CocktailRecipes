{
  "name": "cocktail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter cocktail-server dev\" \"pnpm --filter cocktail-client dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:coverage",
    "test:coverage": "pnpm -r test:coverage",
    "e2e": "playwright test",
    "probe": "node scripts/load-probe.mjs --gate-flood"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^8.2.2",
    "knip": "^6.43.0",
    "prettier": "^3.9.10"
  }
}
